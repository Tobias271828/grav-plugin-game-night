# Game Night (Standalone): nur index.php und assets/ sind von außen erreichbar.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_authz_core.c>
    <FilesMatch "^(config|config\.example)\.php$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(core|data)(/|$) - [F,L]
</IfModule>
